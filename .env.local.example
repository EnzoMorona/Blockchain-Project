# RPC da devnet. Pode usar o default da Solana ou o endpoint da QuickNode do workshop.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Se quiser usar o mesmo RPC no backend (opcional, cai no NEXT_PUBLIC_SOLANA_RPC_URL se ausente):
# SOLANA_RPC_URL=https://polished-dry-forest.solana-devnet.quiknode.pro/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/

# Chave secreta da carteira "casa" (devnet), gerada com `npm run setup:house`.
# NUNCA use essa chave em mainnet nem faça commit dela.
HOUSE_SECRET_KEY=
